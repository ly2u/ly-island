{
    email {$ACME_EMAIL}
}

rqly.com {
    # Start with one week; wildcard subdomains have not all been verified.
    header Strict-Transport-Security "max-age=604800"
    header >Strict-Transport-Security "max-age=604800"
    @withdrawn_photo path /bridge.jpg /bridge.jpg/* /rqly/bridge.jpg
    handle @withdrawn_photo {
        header Cache-Control "no-store"
        respond 404
    }
    encode zstd gzip
    @legacy_island path /island /island/
    redir @legacy_island /{?query} 308
    handle / {
        header Cache-Control "no-cache"
        header X-Content-Type-Options "nosniff"
        header X-Frame-Options "DENY"
        header Referrer-Policy "strict-origin-when-cross-origin"
        header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        reverse_proxy sites:8080 {
            rewrite /island-home
            header_up X-LY-Island-Home 1
            header_up X-Real-IP {remote_host}
            # Old images lack /island-home: keep rollback serving the static island.
            @legacy_shell status 404
            handle_response @legacy_shell {
                root * /srv/island
                rewrite * /index.html
                file_server
            }
        }
    }
    handle /classic {
        header X-Robots-Tag "noindex, follow"
        rewrite * /
        reverse_proxy sites:8080 {
            header_up X-Real-IP {remote_host}
        }
    }
    handle_path /island/* {
        root * /srv/island
        header X-Content-Type-Options "nosniff"
        route {
            header Cache-Control "no-cache"
            @hashed_island {
                path_regexp island_hash ^/assets/[A-Za-z0-9_-]+-[A-Za-z0-9_-]{8,}\.(js|css)$
                file
            }
            header @hashed_island Cache-Control "public, max-age=31536000, immutable"
            file_server
        }
    }
    handle {
        reverse_proxy sites:8080 {
            header_up X-Real-IP {remote_host}
        }
    }
}

www.rqly.com {
    # Start with one week; wildcard subdomains have not all been verified.
    header Strict-Transport-Security "max-age=604800"
    header >Strict-Transport-Security "max-age=604800"
    redir https://rqly.com{uri} permanent
}


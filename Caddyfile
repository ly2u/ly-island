rqly.com {
    # Start with one week; wildcard subdomains have not all been verified.
    header Strict-Transport-Security "max-age=604800"
    header >Strict-Transport-Security "max-age=604800"
    @withdrawn_photo path /bridge.jpg /bridge.jpg/* /rqly/bridge.jpg
    handle @withdrawn_photo {
        header Cache-Control "no-store"
        respond 404
    }
    encode zstd gzip
    @legacy_island path /island /island/
    redir @legacy_island /{?query} 308
    handle / {
        root * /srv/island
        rewrite * /index.html
        header Cache-Control "no-cache"
        header X-Content-Type-Options "nosniff"
        header X-Frame-Options "DENY"
        header Referrer-Policy "strict-origin-when-cross-origin"
        header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        file_server
    }
    handle /classic {
        header X-Robots-Tag "noindex, follow"
        rewrite * /
        reverse_proxy sites:8080 {
            header_up X-Real-IP {remote_host}
        }
    }
    handle_path /island/* {
        root * /srv/island
        header Cache-Control "no-cache"
        header X-Content-Type-Options "nosniff"
        file_server
    }
    handle {
        reverse_proxy sites:8080 {
            header_up X-Real-IP {remote_host}
        }
    }
}

www.rqly.com {
    # Start with one week; wildcard subdomains have not all been verified.
    header Strict-Transport-Security "max-age=604800"
    header >Strict-Transport-Security "max-age=604800"
    redir https://rqly.com{uri} permanent
}


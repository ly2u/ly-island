# Public addresses
RQLY_URL=https://rqly.com
QIZUI_URL=https://7zui.com
PORT=8080
NODE_ENV=production
TRUST_PROXY=true

# Run: npm run setup (or the Docker command in README.md)
ADMIN_USERNAME=ly
ADMIN_PASSWORD_HASH=

# AI is enabled only when both API key and model are configured.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_JSON_MODE=true
# Use max_completion_tokens for models that require that parameter.
AI_TOKEN_PARAMETER=max_tokens
# Optional; leave empty for reasoning models that do not accept temperature.
AI_TEMPERATURE=

# Optional access code for AI review. Setup generates a private access code.
REVIEW_ACCESS_TOKEN=
AI_HOURLY_PER_IP=5
AI_DAILY_LIMIT=40

# Replace with your email before launch.
ACME_EMAIL=

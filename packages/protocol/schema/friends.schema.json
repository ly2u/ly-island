{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.islands.invalid/0/friends.schema.json",
  "title": "islands/0 friends list",
  "description": "Islands this island follows. Entries with a feed are plain blogs read through RSS or Atom. Uniqueness of entries and that the owner does not list itself are checked by the protocol core.",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/documentHeader"
    }
  ],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/origin"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "since": {
            "$ref": "common.schema.json#/$defs/date"
          },
          "feed": {
            "$ref": "common.schema.json#/$defs/url"
          }
        }
      }
    }
  }
}

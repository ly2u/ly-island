{
  "name": "island-site",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "node scripts/wrangler-config.mjs && wrangler deploy --config wrangler.generated.json",
    "keygen": "node scripts/keygen.mjs",
    "unlocks:save": "node scripts/unlocks.mjs",
    "dev:worker": "npm run build && node scripts/wrangler-config.mjs && wrangler dev --config wrangler.generated.json",
    "smoke:worker": "node scripts/smoke-worker.mjs"
  },
  "dependencies": {
    "astro": "7.3.8",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "wrangler": "4.151.0"
  }
}

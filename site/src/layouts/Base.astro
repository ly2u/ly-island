---
import '../styles/base.css';
import { island } from '../lib/island.js';
import { strings } from '../lib/i18n.js';

interface Props {
  title?: string;
  description?: string;
  /** Pages search engines should leave out, such as the owner's desk. */
  noindex?: boolean;
}

const { config } = await island();
const t = strings(config.language[0]);
const { title, description, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${config.name}` : config.name;
---
<!doctype html>
<html lang={config.language[0]} data-theme={config.theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? config.summary ?? config.name} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="island" href="/.well-known/island.json" />
    <link rel="alternate" type="application/rss+xml" title={config.name} href="/feed.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/island-colors.css" />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="site-header">
      <a class="site-name" href="/">{config.name}</a>
      <nav>
        <a href="/records/">{t.allRecords}</a>
        <a href="/feed.xml">{t.feed}</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>{t.footer}</p>
    </footer>
  </body>
</html>

{
    auto_https off
    admin off
}
:80 {
    handle / {
        reverse_proxy sites:8080 {
            rewrite /island-home
            header_up X-LY-Island-Home 1
            @legacy_shell status 404
            handle_response @legacy_shell {
                root * /srv/island
                rewrite * /index.html
                file_server
            }
        }
    }
    handle_path /island/* {
        root * /srv/island
        route {
            header Cache-Control "no-cache"
            @hashed_island {
                path_regexp island_hash ^/assets/[A-Za-z0-9_-]+-[A-Za-z0-9_-]{8,}\.(js|css)$
                file
            }
            header @hashed_island Cache-Control "public, max-age=31536000, immutable"
            file_server
        }
    }
    handle {
        reverse_proxy sites:8080 {
            header_up X-Real-IP {remote_host}
        }
    }
}
